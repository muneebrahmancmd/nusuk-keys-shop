# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Public URL of the deployed site (used for metadata, sitemap, OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
# Must be a sender on a domain you verified in Resend
EMAIL_FROM="Sagewood Credits <orders@yourdomain.com>"
